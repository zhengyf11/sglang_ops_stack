SGLANG_OPS_DATABASE_URL=sqlite:///./sglang_ops_stack.db
SGLANG_OPS_APP_NAME=sglang_ops_stack
SGLANG_OPS_ENVIRONMENT=development
SGLANG_OPS_DOCS_ENABLED=true
SGLANG_OPS_LOG_LEVEL=INFO
SGLANG_OPS_LOG_FORMAT=json
SGLANG_OPS_REQUIRE_HTTPS=false
SGLANG_OPS_SECURITY_HEADERS=x-content-type-options,x-frame-options
SGLANG_OPS_SSH_CONNECT_TIMEOUT=10
SGLANG_OPS_SSH_COMMAND_TIMEOUT=30
SGLANG_OPS_AUTH_SECRET_KEY=replace-with-random-32-byte-secret
SGLANG_OPS_ACCESS_TOKEN_EXPIRE_MINUTES=60
SGLANG_OPS_TASK_QUEUE_MODE=background
SGLANG_OPS_REDIS_URL=redis://localhost:6379/0
SGLANG_OPS_DB_POOL_SIZE=5
SGLANG_OPS_DB_MAX_OVERFLOW=10
SGLANG_OPS_DB_POOL_TIMEOUT=30
SGLANG_OPS_DB_POOL_RECYCLE=1800
# Optional first-run admin provisioning; set only in private deployment environment.
# SGLANG_OPS_BOOTSTRAP_ADMIN_USERNAME=admin
# SGLANG_OPS_BOOTSTRAP_ADMIN_PASSWORD=<set-out-of-band>
